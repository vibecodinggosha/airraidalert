# Telegram API credentials (https://my.telegram.org/apps)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token

# Channel where the bot posts analytics (e.g. @mychannel or -1001234567890)
OUTPUT_CHANNEL_ID=your_output_channel_id

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: session name for Telethon (default: airraidalert)
SESSION_NAME=airraidalert

# Optional: hour to post analytics in Kyiv time (default: 23)
ANALYTICS_HOUR=23
# Optional: minute to post analytics in Kyiv time (default: 45)
ANALYTICS_MINUTE=45
